# ==============================================================================
# 1. Cloudflare Tunnel & Public HTTPS Domain (MANDATORY / 必须项)
# ==============================================================================
# 社交平台 OAuth (X, LinkedIn, Meta, Reddit 等) 强制要求权威公网 HTTPS 回调地址。
# 同时解决浏览器针对 raw IP 的跨域 Cookie 限制问题。
#
# 配置步骤：
# 1. 前往 Cloudflare Zero Trust 控制台 (https://one.dash.cloudflare.com/) ➔ Networks ➔ Tunnels
# 2. 点击 "Create a Tunnel" (选择 Cloudflared)，复制生成的 Tunnel Token 填入下方
# 3. 在 Public Hostname 中添加一条规则：
#    - Domain: 你的公网域名 (例如 postiz.yourdomain.com)
#    - Service Type: HTTP
#    - URL: postiz:5000
# 4. 将下方 MAIN_URL, FRONTEND_URL 替换为你的真实公网域名：
MAIN_URL="https://postiz.yourdomain.com"
FRONTEND_URL="https://postiz.yourdomain.com"
NEXT_PUBLIC_BACKEND_URL="https://postiz.yourdomain.com/api"

# Cloudflare Tunnel 权威 HTTPS 环境下设为 false（保证安全 Cookie）
NOT_SECURED="false"

# Cloudflare Tunnel Token (MANDATORY - 必填，以 ey... 开头)
CLOUDFLARE_TUNNEL_TOKEN=""

# ==============================================================================
# 2. Postiz Core & Authentication Configuration
# ==============================================================================
# Secret Key for JWT Authentication (generate a random 32+ char string: openssl rand -hex 32)
JWT_SECRET="replace_with_a_secure_random_32_char_hex_string"

# Database Configuration (matches docker-compose.yml)
POSTGRES_USER="postiz"
POSTGRES_PASSWORD="postiz_password_change_me"
POSTGRES_DB="postiz_db"
DATABASE_URL="postgresql://postiz:postiz_password_change_me@postiz-postgres:5432/postiz_db"

# Redis Configuration
REDIS_URL="redis://postiz-redis:6379"

# Internal backend communication URL for Server-Side Rendering
BACKEND_INTERNAL_URL="http://localhost:3000"

# General standalone instance mode
IS_GENERAL="true"
DISABLE_REGISTRATION="false"
RUN_CRON="true"

# Storage
STORAGE_PROVIDER="local"
UPLOAD_DIRECTORY="/uploads"
NEXT_PUBLIC_UPLOAD_DIRECTORY="/uploads"


# ==============================================================================
# Outbound Encrypted Proxy (for accessing overseas APIs from restricted network)
# Required only if you use: docker compose --profile proxy up -d
# Example: socks5://user:pass@127.0.0.1:1080 or shadowsocks/trojan/http upstream
# ==============================================================================
UPSTREAM_ENCRYPTED_PROXY="socks5://127.0.0.1:1080"
# Uncomment if Postiz should route all its outgoing requests through the local proxy container:
# HTTP_PROXY="http://outbound-proxy:7890"
# HTTPS_PROXY="http://outbound-proxy:7890"

# ==============================================================================
# Optional Platform Developer App Credentials (for connecting your social accounts)
# Leave empty initially; can be configured in Postiz Web UI or here:
# ==============================================================================
# TWITTER_CLIENT_ID=""
# TWITTER_CLIENT_SECRET=""
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""

