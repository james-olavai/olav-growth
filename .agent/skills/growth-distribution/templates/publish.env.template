# Social Publishing API Configuration Template
# Copy this file to `.env` in your workspace root and fill in your keys.

# 1. Postiz (Recommended Open-Source Alternative to Buffer with Official MCP & REST API)
POSTIZ_API_KEY="your_postiz_api_key_here"
POSTIZ_BASE_URL="http://localhost:5000"

# 2. Buffer API (Commercial Aggregator)
BUFFER_ACCESS_TOKEN="your_buffer_access_token_here"
BUFFER_PROFILE_IDS="profile_id_linkedin,profile_id_twitter"

# 3. n8n / Make Automation Webhook
N8N_WEBHOOK_URL="https://your-n8n-instance.com/webhook/marketing-publish"

# 4. Telegram Channel Broadcast Bot
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_CHAT_ID="@your_channel_name"

# 5. Community Webhooks (Slack / Discord)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/xxx/yyy"
