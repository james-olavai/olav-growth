# ==============================================================================
# Marketing OS 环境变量配置文件模板 (.env.example)
# 使用方法：复制本文件为 .env，并填入你的实际 API Key、账户凭证与 Webhook
# 命令：cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 分发矩阵与排期平台凭证 (Publishing & Distribution APIs)
# ------------------------------------------------------------------------------
# 自建 Postiz 矩阵分发网关 (对应 deploy/postiz/ 容器栈)
POSTIZ_API_URL=http://localhost:5000/api/public/v1
POSTIZ_API_KEY=your_postiz_api_key_here

# Buffer 官方 REST API (支持 X, LinkedIn, Facebook, Instagram 等)
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here
BUFFER_PROFILE_IDS=profile_id_twitter,profile_id_linkedin

# n8n / Make 自动化工作流 Webhook 触发地址
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/marketing-publish

# ------------------------------------------------------------------------------
# 2. 社区与即时通知 Webhook (Notifications & Mobile Gatekeeper)
# ------------------------------------------------------------------------------
# Telegram 频道广播 / 手机端把关审核通知 (获取方式：@BotFather 创建 Bot)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHAT_ID=-1001234567890

# Slack 团队通知 Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXXX

# Discord 社区广播 Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456/abcdef

# ------------------------------------------------------------------------------
# 3. 网络与代理配置 (Network & Proxy Settings)
# ------------------------------------------------------------------------------
# 国内服务器或本地抓取 Google Trends / X / Reddit 时若需代理，请取消注释
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ------------------------------------------------------------------------------
# 4. 大模型 API 密钥 (可选：独立调用第三方 LLM 接口时使用)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-xxxx
# ANTHROPIC_API_KEY=sk-ant-xxxx
# GEMINI_API_KEY=AIzaxxxx

# ------------------------------------------------------------------------------
# 5. 持久化自动化浏览器与中文渠道 (Persistent Browser & Chinese Channels)
# ------------------------------------------------------------------------------
CHROME_CDP_URL=http://localhost:9222
CHROME_VNC_URL=http://localhost:3000

# 浏览器 Web VNC 访问账号与密码（可选：若向局域网或公网开放，建议设置）
# BROWSER_USERNAME=admin
# BROWSER_PASSWORD=your_secure_password_here

# 小红书与知乎 Cookie (启动 ./deploy-browser.sh 扫码后执行 sync_browser_cookies.py 自动填入)
XHS_COOKIE=
ZHIHU_COOKIE=

# 微信公众号官方开发者凭据 (推送至草稿箱)
WECHAT_APPID=
WECHAT_APPSECRET=

# ------------------------------------------------------------------------------
# 6. 联合搜索与全网情报侦测 (Union Search API Keys - 可选)
# 大部分平台（DuckDuckGo、360搜索、搜狗、GitHub、Wikipedia、18平台图片等）无需 Key 开箱即用
# ------------------------------------------------------------------------------
# GITHUB_TOKEN=ghp_xxxx
# TIKHUB_TOKEN=your_tikhub_token_here       # 用于小红书/抖音/Bilibili/Twitter
# TAVILY_API_KEY=tvly-xxxx                  # 用于 AI 深度事实与基准检索
# METASO_API_KEY=your_metaso_key_here       # 秘塔 AI 搜索
# VOLCENGINE_API_KEY=your_volcengine_key    # 字节跳动火山引擎融合搜索
# GOOGLE_API_KEY=your_google_key
# GOOGLE_SEARCH_ENGINE_ID=your_engine_id

